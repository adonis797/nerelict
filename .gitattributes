# 统一换行符，避免 Windows 检出后 gradlew 变成 CRLF、在 Linux/CI 上无法执行
* text=auto

*.dart text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.aar binary
*.so binary
*.apk binary
